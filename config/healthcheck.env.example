# =============================================================================
# Varry LLC · WP Maintenance — configuration
# -----------------------------------------------------------------------------
# Copy this file to `healthcheck.env` and fill in the values, then keep it
# private:   cp config/healthcheck.env.example config/healthcheck.env
#            chmod 600 config/healthcheck.env
#
# `healthcheck.env` is git-ignored on purpose — it holds your API key.
# Every value below can also be supplied as a real environment variable
# (the environment always wins over the file).
# =============================================================================

# --- Branding -----------------------------------------------------------------
# Shown in the report header, e-mail, and PDF footer.
BRAND_COMPANY="Varry LLC"
BRAND_PROJECT="WP Maintenance"
# Optional: absolute or repo-relative path to a logo (SVG or PNG).
BRAND_LOGO="assets/varry-logo.svg"

# --- E-mail delivery (EmailIt — https://emailit.com/docs) ---------------------
# API key (Bearer token) from the EmailIt dashboard. REQUIRED to send e-mail.
EMAILIT_API_KEY=""
# Sender must be on a domain that is *verified* in your EmailIt account.
MAIL_FROM="WP Maintenance <wpmaintenance@fedx.io>"
# Comma-separated recipient list.
MAIL_TO="trevor.lowing@gmail.com"
# Optional reply-to.
MAIL_REPLY_TO=""

# --- Hosts / sites ------------------------------------------------------------
# Human-friendly server name shown in the report. Defaults to `hostname`.
SERVER_LABEL=""
# Web root that holds the WordPress installs (xCloud/OpenLiteSpeed default).
WWW_ROOT="/var/www"

# --- SSH log analysis ---------------------------------------------------------
# Comma-separated IPs/prefixes known to be legitimate management sources
# (e.g. your xCloud control-plane key + your CI/automation worker). Successful
# *key-based* logins from these are treated as expected; anything else — and
# ANY password-based root login regardless of source — is escalated. Prefix
# match is supported.
#   13.229.188.242 = xCloud control plane (publickey, ~2h cadence)
#   13.250.4.14    = automation/maintenance worker (publickey)
SSH_ALLOWLIST="13.229.188.242,13.250.4.14"

# --- Thresholds (tune to taste) ----------------------------------------------
DISK_WARN_PCT="80"        # warn when any monitored filesystem is >= this %
DISK_ALERT_PCT="90"       # ALERT when >= this %
SSL_WARN_DAYS="21"        # warn when a cert expires within N days
SSL_ALERT_DAYS="10"       # ALERT when a cert expires within N days
