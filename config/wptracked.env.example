# =============================================================================
# WPTracked — configuration  (by Varry LLC · https://wptracked.com)
# -----------------------------------------------------------------------------
# Copy this file to `wptracked.env`, fill in the values, then lock it down:
#     cp config/wptracked.env.example config/wptracked.env
#     chmod 600 config/wptracked.env
#
# `wptracked.env` is git-ignored on purpose — it holds your mail credentials.
# Every value below can also be supplied as a real environment variable
# (the environment always wins over this file).
#
# Everything has a safe default: with an empty file WPTracked still runs a full
# read-only health check and generates the report — it just won't e-mail it
# until a mail transport is configured.
# =============================================================================

# --- What to run -------------------------------------------------------------
# MODE selects the scope of the audit:
#   server       -> host infrastructure + logs only (no WordPress)
#   server+wp    -> everything (default)
WPT_MODE="server+wp"

# Per-check toggles. All ON by default ("1"); set to "0" to disable a check.
# Disabling a check removes it from collection AND the report.
CHECK_DISK="1"            # disk space + inode pressure
CHECK_SSL="1"             # TLS certificate expiry per site
CHECK_UPDATES="1"         # pending OS / security package updates + reboot flag
CHECK_WEB_LOGS="1"        # web server error + access log scan (5xx, probes)
CHECK_AUTH_LOG="1"        # SSH auth.log brute-force / login analysis (root only)
CHECK_WP_CORE="1"         # wp core verify-checksums (tamper detection)  [wp]
CHECK_WP_UPDATES="1"      # plugin / theme available-update check         [wp]
CHECK_WP_VULN="1"         # plugin / theme vulnerability + CISA KEV scan  [wp]
CHECK_WP_SECURITY="1"     # WordPress security best-practices audit       [wp]

# --- Branding ----------------------------------------------------------------
# Shown in the report header, e-mail, and PDF footer. Override to re-brand for
# another client without touching code.
BRAND_COMPANY="Varry LLC"
BRAND_PROJECT="WPTracked"
# Absolute or repo-relative path to a logo (SVG or PNG). A matching
# "*-light" variant (white wordmark) is auto-used for the dark report header.
BRAND_LOGO="assets/wptracked-logo.svg"

# --- E-mail delivery (provider-agnostic) -------------------------------------
# MAIL_TRANSPORT selects how the report is sent:
#   emailit   -> EmailIt HTTP API      (https://emailit.com/docs)
#   smtp      -> any SMTP server (Gmail, SES, Postfix, Fastmail, …)
#   sendgrid  -> SendGrid  v3 HTTP API
#   mailgun   -> Mailgun   HTTP API
#   resend    -> Resend    HTTP API
#   none      -> never send (generate report only)
MAIL_TRANSPORT="emailit"

# Common addressing (all transports).
MAIL_FROM="WPTracked <wptracked@example.com>"   # sender on a *verified* domain
MAIL_TO="you@example.com"                        # comma-separated recipients
MAIL_REPLY_TO=""                                 # optional

# -- emailit --
EMAILIT_API_KEY=""

# -- smtp --   (SMTP_SECURITY: starttls | ssl | none)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURITY="starttls"

# -- sendgrid --
SENDGRID_API_KEY=""

# -- mailgun --   (region base, e.g. https://api.mailgun.net or .eu.mailgun.net)
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_BASE="https://api.mailgun.net"

# -- resend --
RESEND_API_KEY=""

# --- Scheduling (used by bin/install-cron.sh) --------------------------------
# SCHEDULE_FREQUENCY: hourly | daily | weekly | monthly
# SCHEDULE_TIME:      HH:MM local time (ignored for hourly)
# SCHEDULE_DOW:       0-6 (Sun-Sat) for weekly;  SCHEDULE_DOM: 1-28 for monthly
SCHEDULE_FREQUENCY="daily"
SCHEDULE_TIME="07:15"
SCHEDULE_DOW="1"
SCHEDULE_DOM="1"

# --- Hosts / sites -----------------------------------------------------------
SERVER_LABEL=""            # friendly server name (defaults to `hostname`)
WWW_ROOT="/var/www"        # web root holding the WordPress installs

# --- SSH log analysis --------------------------------------------------------
# Comma-separated IPs/prefixes known to be legitimate management sources
# (e.g. your control-plane key + your CI/automation worker). Successful
# *key-based* logins from these are treated as expected; anything else — and
# ANY password-based root login regardless of source — is escalated.
SSH_ALLOWLIST=""

# --- Thresholds (tune to taste) ----------------------------------------------
DISK_WARN_PCT="80"         # warn when any monitored filesystem is >= this %
DISK_ALERT_PCT="90"        # ALERT when >= this %
SSL_WARN_DAYS="21"         # warn when a cert expires within N days
SSL_ALERT_DAYS="10"        # ALERT when a cert expires within N days
